# Copy this file to .env and fill in values as needed.

# sqlite (default, local and Streamlit Cloud) or sqlserver (optional production)
DB_ENGINE=sqlite

# --- SQL Server settings (only if DB_ENGINE=sqlserver) ---
DB_SERVER=localhost
DB_NAME=HospitalDB
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Kaggle credentials (only for live dataset download) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- AI assistant ---
# Local: set USE_OLLAMA=1 after installing Ollama and pulling llama3.2
USE_OLLAMA=0
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# Hosted / optional cloud LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
